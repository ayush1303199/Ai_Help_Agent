  "main": "electron/main.cjs",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.aihelpagent.desktop",
    "productName": "AI Help Agent",
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://example.invalid/ai-help-agent"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "src/config/providerRegistry.json",
      "src/config/providerErrorPatterns.json",
      "src/config/runtimeSettings.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend-dist/ai-help-agent-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
