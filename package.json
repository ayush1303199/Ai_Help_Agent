{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "description": "AI Help Agent desktop assistant",
  "author": "AI Help Agent",
  "repository": "https://github.com/ayush1303199/Ai_Help_Agent",
  "type": "module",
  "scripts": {
    "dev": "npm run electron:dev",
    "preflight": "node scripts/launcher-preflight.mjs",
    "web:dev": "vite",
    "server:dev": "npm --prefix server run dev",
    "electron:dev": "npm run preflight && node scripts/electron-dev.mjs",
    "electron:start": "electron electron/main.cjs",
    "desktop:build": "npm run build:backend && npm run build && electron-builder --win nsis --publish never",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "vite build",
    "test": "node scripts/test-all.mjs",
    "test:developer-agent": "node scripts/developer-agent-test.mjs",
    "test:database-discovery": "node scripts/database-discovery-test.mjs",
    "test:developer-discovery": "node scripts/developer-project-discovery-test.mjs",
    "test:developer-pipeline": "node scripts/developer-pipeline-contract-test.mjs",
    "test:developer-gates": "node scripts/developer-gates-test.mjs",
    "test:developer-lifecycle": "node scripts/developer-lifecycle-test.mjs",
    "test:developer-sync-contract": "node scripts/coding-sync-contract-test.mjs",
    "test:developer-real-world": "node scripts/coding-real-world-e2e-test.mjs",
    "test:coding-markdown": "node scripts/coding-markdown-test.mjs",
    "test:coding-activity": "node --experimental-strip-types scripts/coding-activity-trace-test.mjs",
    "test:coding-policy": "python scripts/coding-agent-policy-test.py",
    "test:coding-universal": "python scripts/coding-universal-architecture-test.py",
    "test:coding-journey": "python scripts/coding-live-user-journey-test.py",
    "test:coding-performance": "node scripts/coding-performance-investigation-test.mjs",
    "test:coding-business-revalidation": "node scripts/coding-business-truth-revalidation-test.mjs",
    "audit:coding-truth": "node scripts/coding-forensic-truth-audit.mjs",
    "test:coding-stage19": "node scripts/coding-blind-reality-stage19-test.mjs",
    "test:coding-stage18": "node scripts/coding-quality-correctness-stage18-test.mjs",
    "test:coding-stage17": "node scripts/coding-runtime-integration-stage17-test.mjs",
    "test:coding-reality": "node scripts/coding-reality-engine-stage16-test.mjs",
    "test:coding-omni": "node scripts/coding-omni-stage15-test.mjs",
    "test:coding-stage14": "node scripts/coding-autonomous-stage14-test.mjs",
    "test:coding-e2e": "node scripts/coding-autonomous-e2e-test.mjs",
    "test:coding-acceptance": "node scripts/coding-intelligence-acceptance-test.mjs",
    "test:coding-diff": "node --experimental-strip-types scripts/coding-diff-test.mjs",
    "test:assistant-smoke": "node --experimental-strip-types scripts/assistant-smoke-test.mjs",
    "test:document-service": "node --experimental-strip-types scripts/document-service-test.mjs",
    "test:stt-service": "node --experimental-strip-types scripts/stt-service-test.mjs",
    "test:backend-services": "python scripts/backend-services-test.py",
    "test:interview-context": "node --experimental-strip-types scripts/interview-context-test.mjs",
    "test:context-dialog": "node scripts/context-dialog-test.mjs",
    "test:configuration-ui": "node scripts/configuration-ui-test.mjs",
    "test:provider-config": "node --experimental-strip-types scripts/provider-config-test.mjs",
    "test:overlay": "node scripts/overlay-static-test.mjs",
    "test:overlay-insights": "node --experimental-strip-types scripts/overlay-answer-insights-test.mjs",
    "test:meeting-overlay": "node --experimental-strip-types scripts/meeting-overlay-protocol-test.mjs",
    "test:meeting-audio": "node --experimental-strip-types scripts/meeting-audio-quality-test.mjs",
    "test:meeting-capture-lifecycle": "node --experimental-strip-types scripts/meeting-capture-lifecycle-test.mjs",
    "test:meeting-ui": "node scripts/meeting-ui-integration-test.mjs",
    "test:meeting-transport": "node --experimental-strip-types scripts/meeting-transport-test.mjs",
    "test:architecture": "node scripts/architecture-boundary-test.mjs",
    "test:runtime-settings": "node scripts/runtime-settings-test.mjs",
    "test:general-agent-runtime": "node scripts/general-agent-runtime-test.mjs",
    "test:general-agent-context": "python scripts/general-agent-context-test.py",
    "test:general-agent-provider-compatibility": "python scripts/general-agent-provider-compatibility-test.py",
    "validate:general-agent-real": "electron scripts/general-agent-real-validation.cjs",
    "validate:provider-live-e2e": "node scripts/provider-live-e2e.mjs",
    "validate:general-agent-provider-browser": "electron scripts/general-agent-provider-browser-e2e.cjs",
    "test:general-agent-capability": "node scripts/general-agent-capability-test.mjs",
    "test:general-agent-benchmark": "node scripts/general-agent-benchmark.mjs",
    "test:general-agent-execution": "node scripts/general-agent-execution-test.mjs",
    "test:general-agent-execution-integration": "node scripts/general-agent-execution-integration-test.mjs",
    "test:general-agent-electron-browser": "node scripts/general-agent-electron-browser-test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "jsdom": "^26.1.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.aihelpagent.desktop",
    "productName": "AI Help Agent",
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://example.invalid/ai-help-agent"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "src/config/providerRegistry.json",
      "src/config/providerErrorPatterns.json",
      "src/config/runtimeSettings.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend-dist/ai-help-agent-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
