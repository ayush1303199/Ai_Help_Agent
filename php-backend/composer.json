{
  "name": "example/ai-assistant-yii2",
  "description": "PHP/Yii2 backend API example for the AI Assistant project",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2-app-basic": "~2.0.0",
    "yiisoft/yii2": "~2.0.45",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "yiisoft/yii2-debug": "~2.1.0",
    "yiisoft/yii2-gii": "~2.2.0"
  },
  "scripts": {
    "post-install-cmd": [
      "yii\\composer\\Install::postInstall"
    ]
  },
  "extra": {
    "yii\\composer\\Install::postInstall": {
      "generateCookieValidationKey": true
    }
  },
  "config": {
    "process-timeout": 1800,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  }
}
